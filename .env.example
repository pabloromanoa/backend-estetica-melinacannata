# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL del frontend (CORS + enlaces privados enviados a invitados)
FRONTEND_URL=http://localhost:5173
# Orígenes extra permitidos, separados por coma (opcional)
CORS_ORIGINS=

# ─── Base de datos (MySQL 8 / MariaDB 10.11+) ────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=estetica
DB_PASSWORD=estetica
DB_NAME=estetica
# Nunca true en producción: el esquema se maneja con migraciones
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# ─── Seguridad ───────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-32+chars
JWT_EXPIRES_IN_SECONDS=28800
# true en producción (requiere HTTPS)
COOKIE_SECURE=false

# ─── Reglas de negocio ───────────────────────────────────────────────
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
BOOKING_HOLD_MINUTES=5
# Bloqueo para turnos cargados por el personal (pendiente de validar con el negocio)
STAFF_BOOKING_HOLD_MINUTES=30
DEPOSIT_PERCENTAGE=50
CANCELLATION_REFUND_HOURS=24
REMINDER_HOURS_BEFORE=24

# ─── Comprobantes (directorio PRIVADO, fuera de cualquier carpeta pública) ─
RECEIPTS_STORAGE_DIR=./storage/receipts
RECEIPT_MAX_BYTES=5242880

# ─── Administrador inicial (seeder idempotente al arrancar) ──────────
ADMIN_EMAIL=admin@melinacannata.com
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_FIRST_NAME=Melina
ADMIN_LAST_NAME=Cannata
# La dueña también atiende: se le crea perfil de prestadora
ADMIN_IS_PROVIDER=true

# ─── Laya (microservicio Python interno). Vacío = usa sólo reglas ────
LAYA_URL=http://localhost:8000
LAYA_TIMEOUT_MS=3000

# ─── Notificaciones: log (desarrollo) | whatsapp-cloud ───────────────
NOTIFICATIONS_PROVIDER=log
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Rate limiting global ────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
